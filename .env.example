# Copy to .env for local development and fill in values.
# On Railway, set these in the Variables dashboard — DO NOT commit a filled .env file.

# Required
GROQ_API_KEY=your_groq_api_key_here
API_KEY=your_secret_api_key_here

# Optional — Supabase integration
SUPABASE_URL=
SUPABASE_KEY=

# Optional — Agent behaviour
BUSINESS_SYSTEM_PROMPT=You are BRIO, a highly capable customer support assistant. Answer politely, accurately, and in a human tone.
BRIO_MEMORY_WINDOW=10
BRIO_RAG_CHUNK_SIZE=300
BRIO_RAG_CHUNK_OVERLAP=50
BRIO_TOP_K_DOCS=3
BRIO_MIN_CONFIDENCE=0.70

# Optional — writable path for conversation history (defaults to system temp dir)
# CONVERSATION_HISTORY_PATH=/tmp
